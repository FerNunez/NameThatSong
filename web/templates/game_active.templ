package templates

import (
	"strconv"
)

type GameState struct {
	ID           string `json:"id"`
	CurrentRound int    `json:"current_round"`
	TotalRounds  int    `json:"total_rounds"`
	Score        int    `json:"score"`
	TimeLeft     int    `json:"time_left"`
	Status       string `json:"status"`
	Difficulty   string `json:"difficulty"`
}

type CurrentSong struct {
	ID          string `json:"id"`
	Title       string `json:"title"`
	Artist      string `json:"artist"`
	Album       string `json:"album"`
	AlbumArt    string `json:"album_art"`
	PreviewURL  string `json:"preview_url"`
	IsPlaying   bool   `json:"is_playing"`
}

templ GameActivePage(game GameState, song CurrentSong) {
	<div id="game-container" class="min-h-screen bg-gradient-to-b from-gray-900 to-gray-800 text-white">
		<!-- Game Header -->
		<div class="container mx-auto px-4 py-4">
			<div class="bg-gray-800 rounded-xl p-4 mb-6 border border-gray-700">
				<div class="flex justify-between items-center">
					<!-- Round Info -->
					<div class="flex items-center space-x-4">
						<div class="text-center">
							<span class="text-2xl font-bold text-green-400">{ strconv.Itoa(game.CurrentRound) }</span>
							<span class="text-gray-400 text-sm">/ { strconv.Itoa(game.TotalRounds) }</span>
							<p class="text-xs text-gray-500">Round</p>
						</div>
						<div class="w-px h-12 bg-gray-600"></div>
						<div class="text-center">
							<span class="text-2xl font-bold text-blue-400">{ strconv.Itoa(game.Score) }</span>
							<p class="text-xs text-gray-500">Score</p>
						</div>
						<div class="w-px h-12 bg-gray-600"></div>
						<div class="text-center">
							<span class="text-lg font-mono text-yellow-400 uppercase">{ game.Difficulty }</span>
							<p class="text-xs text-gray-500">Difficulty</p>
						</div>
					</div>

					<!-- Timer -->
					<div class="text-center">
						<div id="timer" 
						     class="text-4xl font-bold text-red-400 mb-1"
						     hx-get={ "/game/timer?id=" + game.ID } 
						     hx-trigger="every 1s"
						     hx-target="this"
						     hx-swap="innerHTML">
							{ strconv.Itoa(game.TimeLeft) }s
						</div>
						<div class="w-20 h-2 bg-gray-700 rounded-full overflow-hidden">
							<div class="timer-bar h-full bg-red-400 transition-all duration-1000 ease-linear" 
							     style={ "width: " + strconv.Itoa((game.TimeLeft*100)/30) + "%" }></div>
						</div>
					</div>

					<!-- Game Controls -->
					<div class="flex space-x-2">
						<button hx-post={ "/game/pause?id=" + game.ID } 
						        hx-target="#game-container"
						        class="bg-gray-600 hover:bg-gray-500 p-2 rounded-lg transition-colors"
						        title="Pause Game">
							<svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
								<path d="M6 4h4v16H6V4zm8 0h4v16h-4V4z"></path>
							</svg>
						</button>
						<button hx-post={ "/game/quit?id=" + game.ID }
						        hx-target="#game-container"
						        hx-confirm="Are you sure you want to quit? Your progress will be lost."
						        class="bg-red-600 hover:bg-red-500 p-2 rounded-lg transition-colors"
						        title="Quit Game">
							<svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
								<path d="M19 6.41L17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z"></path>
							</svg>
						</button>
					</div>
				</div>
			</div>

			<!-- Progress Bar -->
			<div class="mb-6">
				<div class="flex justify-between text-sm text-gray-400 mb-2">
					<span>Game Progress</span>
					<span>{ strconv.Itoa((game.CurrentRound*100)/game.TotalRounds) }% Complete</span>
				</div>
				<div class="w-full bg-gray-700 rounded-full h-3">
					<div class="bg-gradient-to-r from-green-400 to-blue-500 h-3 rounded-full transition-all duration-500"
					     style={ "width: " + strconv.Itoa((game.CurrentRound*100)/game.TotalRounds) + "%" }></div>
				</div>
			</div>

			<!-- Music Player Section -->
			<div class="bg-gray-800 rounded-xl p-6 mb-6 border border-gray-700">
				<div class="flex items-center justify-between mb-4">
					<h2 class="text-xl font-semibold">🎵 Now Playing</h2>
					<div class="flex space-x-2">
						<button id="play-pause-btn"
						        hx-post={ "/game/toggle-playback?id=" + game.ID }
						        hx-target="#audio-controls"
						        class="bg-green-500 hover:bg-green-600 p-3 rounded-full transition-colors">
							if song.IsPlaying {
								<svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24">
									<path d="M6 4h4v16H6V4zm8 0h4v16h-4V4z"></path>
								</svg>
							} else {
								<svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24">
									<path d="M8 5v14l11-7z"></path>
								</svg>
							}
						</button>
						<button hx-post={ "/game/skip?id=" + game.ID }
						        hx-target="#game-container"
						        hx-confirm="Skip this song? You'll lose points but move to the next question."
						        class="bg-yellow-600 hover:bg-yellow-500 p-3 rounded-full transition-colors">
							<svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24">
								<path d="M6 18l8.5-6L6 6v12zM16 6v12h2V6h-2z"></path>
							</svg>
						</button>
					</div>
				</div>

				<div class="flex items-center space-x-6">
					<!-- Album Art -->
					<div class="w-24 h-24 bg-gray-700 rounded-lg flex items-center justify-center overflow-hidden">
						if song.AlbumArt != "" {
							<img src={ song.AlbumArt } alt="Album Cover" class="w-full h-full object-cover"/>
						} else {
							<svg class="w-12 h-12 text-gray-500" fill="currentColor" viewBox="0 0 24 24">
								<path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 14.5v-9l6 4.5-6 4.5z"></path>
							</svg>
						}
					</div>

					<!-- Song Info (Hidden during gameplay) -->
					<div class="flex-1">
						<div class="bg-gray-700 rounded-lg p-4">
							<div class="text-center">
								<div class="text-gray-400 text-lg mb-2">❓ Mystery Song Playing</div>
								<div class="text-sm text-gray-500">Listen carefully and make your guess!</div>
							</div>
						</div>
					</div>

					<!-- Audio Visualizer Placeholder -->
					<div class="w-32 h-16 bg-gray-700 rounded-lg flex items-center justify-center">
						<div class="flex space-x-1 items-end">
							for i := 0; i < 8; i++ {
								<div class="w-1 bg-green-400 rounded-full animate-pulse" style={ "height: " + strconv.Itoa(20+(i%3)*10) + "px" }></div>
							}
						</div>
					</div>
				</div>

				<!-- Audio Controls (Hidden audio element) -->
				<div id="audio-controls" class="mt-4">
					if song.PreviewURL != "" {
						<audio id="game-audio" src={ song.PreviewURL } preload="auto"></audio>
					}
				</div>
			</div>

			<!-- Question & Answer Section -->
			<div class="bg-gray-800 rounded-xl p-6 mb-6 border border-gray-700">
				<div class="text-center mb-6">
					<h2 class="text-2xl font-bold mb-2">What song is this?</h2>
					<p class="text-gray-400">Type your answer below</p>
				</div>

				<!-- Answer Form -->
				<form id="answer-form" 
				      hx-post={ "/game/submit-answer?id=" + game.ID }
				      hx-target="#game-container"
				      hx-on:htmx:after-request="handleAnswerSubmit()"
				      class="max-w-md mx-auto">
					<div class="flex space-x-3">
						<input type="text" 
						       name="answer" 
						       id="answer-input"
						       placeholder="Enter song title..."
						       autocomplete="off"
						       class="flex-1 bg-gray-700 border border-gray-600 rounded-lg px-4 py-3 text-white placeholder-gray-400 focus:border-green-500 focus:ring-1 focus:ring-green-500 text-lg"
						       required/>
						<button type="submit" 
						        class="bg-green-500 hover:bg-green-600 px-6 py-3 rounded-lg font-semibold transition-colors">
							Submit
						</button>
					</div>
				</form>

				<!-- Hints Section -->
				<div class="mt-6 text-center">
					<button id="hint-btn"
					        hx-post={ "/game/get-hint?id=" + game.ID }
					        hx-target="#hint-display"
					        class="bg-blue-600 hover:bg-blue-500 px-4 py-2 rounded-lg text-sm transition-colors">
						💡 Get Hint (-10 points)
					</button>
					<div id="hint-display" class="mt-3 text-gray-400"></div>
				</div>
			</div>

			<!-- Answer Feedback (Hidden by default) -->
			<div id="answer-feedback" class="hidden fixed inset-0 bg-black bg-opacity-50 flex items-center justify-center z-50">
				<div id="feedback-content" class="bg-gray-800 rounded-xl p-8 max-w-md mx-4 text-center border border-gray-700">
					<!-- Content will be populated by JavaScript -->
				</div>
			</div>
		</div>
	</div>

	<script>
		// Auto-focus answer input
		document.getElementById('answer-input').focus();

		// Handle form submission feedback
		function handleAnswerSubmit() {
			// Show loading state
			const submitBtn = document.querySelector('#answer-form button[type="submit"]');
			const originalText = submitBtn.textContent;
			submitBtn.textContent = 'Checking...';
			submitBtn.disabled = true;

			// Reset after response
			setTimeout(() => {
				submitBtn.textContent = originalText;
				submitBtn.disabled = false;
			}, 1000);
		}

		// Handle audio playback
		const audio = document.getElementById('game-audio');
		const playPauseBtn = document.getElementById('play-pause-btn');

		if (audio) {
			// Auto-play after a short delay
			setTimeout(() => {
				audio.play().catch(e => console.log('Auto-play prevented by browser'));
			}, 500);

			// Update button based on audio state
			audio.addEventListener('play', () => {
				playPauseBtn.innerHTML = '<svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24"><path d="M6 4h4v16H6V4zm8 0h4v16h-4V4z"></path></svg>';
			});

			audio.addEventListener('pause', () => {
				playPauseBtn.innerHTML = '<svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24"><path d="M8 5v14l11-7z"></path></svg>';
			});

			// Handle playback button
			playPauseBtn.addEventListener('click', (e) => {
				e.preventDefault();
				if (audio.paused) {
					audio.play();
				} else {
					audio.pause();
				}
			});
		}

		// Keyboard shortcuts
		document.addEventListener('keydown', (e) => {
			if (e.key === 'Enter' && e.target.id !== 'answer-input') {
				document.getElementById('answer-input').focus();
			}
			if (e.key === ' ' && e.target.id !== 'answer-input') {
				e.preventDefault();
				if (audio) {
					audio.paused ? audio.play() : audio.pause();
				}
			}
		});

		// Show answer feedback
		function showAnswerFeedback(isCorrect, correctAnswer, points) {
			const feedback = document.getElementById('answer-feedback');
			const content = document.getElementById('feedback-content');
			
			if (isCorrect) {
				content.innerHTML = `
					<div class="text-green-400 mb-4">
						<svg class="w-16 h-16 mx-auto mb-4" fill="currentColor" viewBox="0 0 24 24">
							<path d="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z"></path>
						</svg>
						<h3 class="text-2xl font-bold">Correct!</h3>
					</div>
					<p class="text-lg mb-4">+${points} points</p>
					<button onclick="hideFeedback()" class="bg-green-500 hover:bg-green-600 px-4 py-2 rounded-lg">
						Next Question
					</button>
				`;
			} else {
				content.innerHTML = `
					<div class="text-red-400 mb-4">
						<svg class="w-16 h-16 mx-auto mb-4" fill="currentColor" viewBox="0 0 24 24">
							<path d="M19 6.41L17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z"></path>
						</svg>
						<h3 class="text-2xl font-bold">Wrong Answer</h3>
					</div>
					<p class="text-lg mb-2">The correct answer was:</p>
					<p class="text-xl font-bold text-white mb-4">${correctAnswer}</p>
					<button onclick="hideFeedback()" class="bg-red-500 hover:bg-red-600 px-4 py-2 rounded-lg">
						Next Question
					</button>
				`;
			}
			
			feedback.classList.remove('hidden');
		}

		function hideFeedback() {
			document.getElementById('answer-feedback').classList.add('hidden');
		}

		// Timer warning
		function updateTimerColor(timeLeft) {
			const timer = document.getElementById('timer');
			const timerBar = document.querySelector('.timer-bar');
			
			if (timeLeft <= 5) {
				timer.classList.add('animate-pulse');
				timer.classList.remove('text-red-400');
				timer.classList.add('text-red-500');
				timerBar.classList.remove('bg-red-400');
				timerBar.classList.add('bg-red-500');
			} else if (timeLeft <= 10) {
				timer.classList.remove('text-red-400');
				timer.classList.add('text-yellow-400');
				timerBar.classList.remove('bg-red-400');
				timerBar.classList.add('bg-yellow-400');
			}
		}
	</script>
}