package templates

import (
	"fmt"
	m "github.com/FerNunez/NameThatSong/internal/models"
)

templ DebugSearch(query string, results interface{}, resultCount int, hasResults bool) {
	@Layout(debugSearchContent(query, results, resultCount, hasResults), "Debug Search")
}

templ debugSearchContent(query string, results interface{}, resultCount int, hasResults bool) {
		<div class="container mx-auto p-4">
			<h1 class="text-3xl font-bold mb-6">Debug Search - Cache Testing</h1>
			
			<div class="bg-blue-100 border border-blue-400 text-blue-700 px-4 py-3 rounded mb-6">
				<p><strong>Instructions:</strong> Search for tracks below. Check the server console/logs to see cache HIT/MISS information.</p>
				<p><strong>Tips:</strong> Search for the same term twice to see cache hit. Try variations like "Beatles" vs "BEATLES!!!" to test normalization.</p>
			</div>
			
			<!-- Search Form -->
			<div class="bg-white shadow-md rounded-lg p-6 mb-6">
				<form method="GET" action="/debug/search" class="flex gap-4">
					<input 
						type="text" 
						name="q" 
						value={ query }
						placeholder="Search for tracks (e.g., Beatles, AC/DC, Twenty-One Pilots)"
						class="flex-1 px-4 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500"
					/>
					<button 
						type="submit"
						class="bg-blue-500 text-white px-6 py-2 rounded-md hover:bg-blue-600 focus:outline-none focus:ring-2 focus:ring-blue-500"
					>
						Search
					</button>
				</form>
			</div>
			
			<!-- Results Section -->
			if hasResults {
				<div class="bg-white shadow-md rounded-lg p-6">
					if query != "" {
						<h2 class="text-xl font-semibold mb-4">
							Search Results for: <span class="text-blue-600">{ query }</span>
						</h2>
					}
					
					<!-- Check if results is an error string -->
					if errorMsg, isError := results.(string); isError {
						<div class="bg-red-100 border border-red-400 text-red-700 px-4 py-3 rounded">
							<p>{ errorMsg }</p>
						</div>
					} else if tracks, isTracks := results.([]m.TrackSearch); isTracks {
						<div class="mb-4">
							<span class="bg-green-100 text-green-800 px-3 py-1 rounded-full text-sm font-medium">
								{ fmt.Sprintf("%d tracks found", resultCount) }
							</span>
						</div>
						
						<div class="space-y-3">
							for _, track := range tracks {
								<div class="border border-gray-200 rounded-lg p-4 hover:bg-gray-50">
									<div class="flex items-start space-x-4">
										if track.AlbumImageURL != "" {
											<img 
												src={ track.AlbumImageURL } 
												alt="Album cover"
												class="w-16 h-16 rounded-lg object-cover"
											/>
										}
										<div class="flex-1 min-w-0">
											<h3 class="text-lg font-semibold text-gray-900 truncate">
												{ track.Name }
											</h3>
											<p class="text-gray-600 truncate">
												by { fmt.Sprintf("%v", track.ArtistNames) }
											</p>
											<p class="text-sm text-gray-500 truncate">
												Album: { track.AlbumName }
											</p>
											<div class="flex items-center space-x-4 mt-2 text-xs text-gray-400">
												<span>Duration: { fmt.Sprintf("%.1f min", float64(track.DurationMs)/60000.0) }</span>
												<span>Popularity: { fmt.Sprintf("%d", track.Popularity) }</span>
												if track.Explicit {
													<span class="bg-gray-200 px-2 py-1 rounded">Explicit</span>
												}
											</div>
										</div>
									</div>
								</div>
							}
						</div>
					} else {
						<div class="bg-yellow-100 border border-yellow-400 text-yellow-700 px-4 py-3 rounded">
							<p>Unexpected result type</p>
						</div>
					}
				</div>
			}
			
			<!-- Instructions -->
			<div class="mt-8 bg-gray-100 rounded-lg p-6">
				<h3 class="text-lg font-semibold mb-3">How to Test Cache Functionality:</h3>
				<ol class="list-decimal list-inside space-y-2 text-gray-700">
					<li>Search for "Beatles" - should see <code>[CACHE MISS]</code> in logs</li>
					<li>Search for "Beatles" again - should see <code>[CACHE HIT]</code> in logs</li>
					<li>Search for "BEATLES!!!" - should see <code>[CACHE HIT]</code> (normalized to same query)</li>
					<li>Search for "twenty-one pilots" vs "Twenty One Pilots" - both should hit same cache</li>
				</ol>
				
				<div class="mt-4 p-3 bg-white rounded border">
					<p class="text-sm font-mono text-gray-600">
						<strong>Example log output:</strong><br/>
						[CACHE MISS] Search tracks: query="Beatles", normalized="beatles", cache_key="spotify:search:tracks:beatles", calling API...<br/>
						[CACHED] Search tracks: query="Beatles", stored 50 results<br/>
						[CACHE HIT] Search tracks: query="BEATLES!!!", normalized="beatles", cache_key="spotify:search:tracks:beatles", results=50
					</p>
				</div>
			</div>
		</div>
}