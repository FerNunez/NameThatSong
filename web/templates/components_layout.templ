package templates

import m "github.com/FerNunez/NameThatSong/internal/api/middleware"

type User struct {
	Name      string
	Email     string
	AvatarURL string
}

type LayoutData struct {
	Title string
	User  *User
}

templ Header(user *User) {
	<header
		class="fixed top-0 left-0 right-0 z-50 flex items-center justify-between 
				   bg-forest-400 border-b border-forest-100 px-10 py-3"
	>
		<!-- Left: Logo + Navigation -->
		<div class="flex items-center gap-8">
			<div class="flex items-center gap-4">
				@MusicIcon()
				<h2 class="text-lg font-bold tracking-tight text-white">NameThatSong</h2>
			</div>
			<nav class="flex items-center gap-9">
				<a href="/premium" class="text-sm font-medium text-forest-50 hover:text-white transition-colors">Premium</a>
				<a href="/support" class="text-sm font-medium text-forest-50 hover:text-white transition-colors">Support</a>
				<a href="/download" class="text-sm font-medium text-forest-50 hover:text-white transition-colors">Download</a>
			</nav>
		</div>
		<!-- Right: Search + Profile -->
		<div class="flex items-center gap-8">
			@SearchInput("Search songs, artists...", "header-search")
			@NotificationButton()
			@UserProfile(user)
		</div>
	</header>
}

templ NotificationButton() {
	<button class="relative p-2 text-forest-50 hover:text-white transition-colors">
		@NotificationIcon()
		<!-- Notification badge -->
		<span class="absolute -top-1 -right-1 w-3 h-3 bg-accent rounded-full"></span>
	</button>
}

templ UserProfile(user *User) {
	{{ _, ok := m.GetUser(ctx) }}
	if ok && user != nil {
		<div class="flex items-center gap-3">
			<div class="text-right">
				<p class="text-sm font-medium text-white">{ user.Email }</p>
				<button
					class="text-xs text-forest-50 hover:text-white transition-colors"
					hx-post="/logout"
					hx-target="body"
					hx-swap="innerHTML"
				>
					Sign out
				</button>
			</div>
			@UserAvatar(user.AvatarURL)
		</div>
	} else {
		<div class="flex items-center gap-4">
			<a href="/register" class="text-sm font-medium text-forest-50 hover:text-white transition-colors">Register</a>
			<a
				href="/login"
				class="px-4 py-2 bg-accent text-forest-400 font-medium rounded-lg hover:bg-opacity-90 transition-colors"
			>
				Login
			</a>
		</div>
	}
}

templ UserAvatar(avatarURL string) {
	<div class="w-8 h-8 rounded-full overflow-hidden bg-forest-200 ring-2 ring-forest-100">
		if avatarURL != "" {
			<img src={ avatarURL } alt="User avatar" class="w-full h-full object-cover"/>
		} else {
			<div class="w-full h-full flex items-center justify-center text-forest-50">
				<svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
					<path d="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z"></path>
				</svg>
			</div>
		}
	</div>
}

templ Sidebar() {
	<aside class="w-80 bg-forest-400 border-r border-forest-100 overflow-auto h-full">
		<!-- Search Section -->
		<div class="px-4 py-6">
			@SearchInput("Search for songs or artists", "sidebar-search")
		</div>
		<!-- Filter Tags -->
		<div class="flex gap-3 px-4 pb-6 flex-wrap">
			@FilterTag("Songs", true)
			@FilterTag("Artists", false)
			@FilterTag("Albums", false)
		</div>
		<!-- Recent Searches -->
		<section class="px-4 pb-6">
			<h3 class="text-lg font-bold mb-4 text-white">Recent searches</h3>
			<div
				id="recent-searches"
				class="space-y-2"
				hx-get="/api/recent-searches"
				hx-trigger="load"
				hx-target="this"
			>
				<!-- HTMX will populate this -->
			</div>
		</section>
		<!-- Library -->
		<section class="px-4 pb-6">
			<h3 class="text-lg font-bold mb-4 text-white">Your Library</h3>
			<div class="space-y-2">
				@LibraryItem("Playlists", "playlist", "/playlists")
				@LibraryItem("Artists", "artist", "/artists")
				@LibraryItem("Albums", "album", "/albums")
				@LibraryItem("Liked Songs", "heart", "/liked")
			</div>
		</section>
	</aside>
}

templ LibraryItem(label, iconType, href string) {
	<a
		href={ templ.SafeURL(href) }
		class="flex items-center gap-3 p-3 rounded-lg hover:bg-forest-300 transition-colors group"
	>
		<div class="w-10 h-10 bg-forest-200 rounded-lg flex items-center justify-center group-hover:bg-forest-100">
			switch iconType {
				case "playlist":
					@MusicIcon()
				case "heart":
					@HeartIcon()
				default:
					@MusicIcon()
			}
		</div>
		<span class="text-white font-medium">{ label }</span>
	</a>
}

templ ModernLayout(contents templ.Component, title string) {
	<html class="h-full bg-forest-400 font-sans">
		<head>
			<title>{ title }</title>
			<meta charset="UTF-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
			<link rel="preconnect" href="https://fonts.googleapis.com"/>
			<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/>
			<link href="https://fonts.googleapis.com/css2?family=Spline+Sans:wght@300;400;500;600;700&display=swap" rel="stylesheet"/>
			<link rel="stylesheet" href="/static/css/style.min.css"/>
		</head>
		<body class="h-full bg-forest-400 text-white overflow-hidden">
			@Header(nil)
			<div class="flex h-full pt-16">
				@Sidebar()
				<main id="main-content" class="flex-1 overflow-auto bg-forest-400">
					<div class="animate-slide-up">
						@contents
					</div>
				</main>
			</div>
			<script src="https://unpkg.com/htmx.org@2.0.3"></script>
			<script src="https://unpkg.com/htmx.org/dist/ext/json-enc.js"></script>
		</body>
	</html>
}
