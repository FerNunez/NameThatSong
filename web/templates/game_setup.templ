package templates

import (
	"github.com/FerNunez/NameThatSong/internal/models"
	"strconv"
)

templ GameSetupPage() {
	<div class="min-h-screen bg-gradient-to-b from-gray-900 to-gray-800 text-white">
		<!-- Header -->
		<div class="container mx-auto px-4 py-8">
			<div class="text-center mb-8">
				<h1 class="text-4xl font-bold mb-4 text-transparent bg-clip-text bg-gradient-to-r from-green-400 to-blue-500">
					🎵 Start New Game
				</h1>
				<p class="text-gray-300 text-lg">Choose your playlist and game settings</p>
			</div>
			<div class="max-w-4xl mx-auto">
				<form hx-post="/game/start" hx-target="body" hx-swap="outerHTML" id="game-setup-form">
					<!-- Playlist Selection -->
					<div class="bg-gray-800 rounded-xl p-6 mb-6 border border-gray-700">
						<h2 class="text-2xl font-semibold mb-4 flex items-center">
							<span class="bg-green-500 text-white rounded-full w-8 h-8 flex items-center justify-center text-sm mr-3">1</span>
							Select Playlist
						</h2>
						<div
							id="playlist-grid"
							hx-get="/api/playlists"
							hx-trigger="load"
							hx-target="this"
							hx-swap="innerHTML"
						>
							<div class="flex items-center justify-center py-8">
								<div class="animate-spin rounded-full h-8 w-8 border-b-2 border-green-500"></div>
								<span class="ml-3 text-gray-400">Loading your playlists...</span>
							</div>
						</div>
					</div>
					<!-- Difficulty Selection -->
					<div class="bg-gray-800 rounded-xl p-6 mb-6 border border-gray-700">
						<h2 class="text-2xl font-semibold mb-4 flex items-center">
							<span class="bg-blue-500 text-white rounded-full w-8 h-8 flex items-center justify-center text-sm mr-3">2</span>
							Choose Difficulty
						</h2>
						<div class="grid grid-cols-1 md:grid-cols-3 gap-4">
							<label class="difficulty-option cursor-pointer">
								<input type="radio" name="difficulty" value="easy" class="sr-only" required/>
								<div class="difficulty-card bg-green-600 hover:bg-green-500 border-2 border-transparent hover:border-green-300 rounded-lg p-4 transition-all duration-200">
									<h3 class="text-xl font-bold mb-2">🟢 Easy</h3>
									<ul class="text-sm space-y-1 text-green-100">
										<li>• Popular songs only</li>
										<li>• 30-second previews</li>
										<li>• Multiple choice answers</li>
										<li>• 30s per question</li>
									</ul>
								</div>
							</label>
							<label class="difficulty-option cursor-pointer">
								<input type="radio" name="difficulty" value="medium" class="sr-only" required/>
								<div class="difficulty-card bg-yellow-600 hover:bg-yellow-500 border-2 border-transparent hover:border-yellow-300 rounded-lg p-4 transition-all duration-200">
									<h3 class="text-xl font-bold mb-2">🟡 Medium</h3>
									<ul class="text-sm space-y-1 text-yellow-100">
										<li>• Mix of popular & deep cuts</li>
										<li>• 20-second previews</li>
										<li>• Type your answer</li>
										<li>• 20s per question</li>
									</ul>
								</div>
							</label>
							<label class="difficulty-option cursor-pointer">
								<input type="radio" name="difficulty" value="hard" class="sr-only" required/>
								<div class="difficulty-card bg-red-600 hover:bg-red-500 border-2 border-transparent hover:border-red-300 rounded-lg p-4 transition-all duration-200">
									<h3 class="text-xl font-bold mb-2">🔴 Hard</h3>
									<ul class="text-sm space-y-1 text-red-100">
										<li>• All songs included</li>
										<li>• 10-second previews</li>
										<li>• Type your answer</li>
										<li>• 15s per question</li>
									</ul>
								</div>
							</label>
						</div>
					</div>
					<!-- Game Settings -->
					<div class="bg-gray-800 rounded-xl p-6 mb-8 border border-gray-700">
						<h2 class="text-2xl font-semibold mb-4 flex items-center">
							<span class="bg-purple-500 text-white rounded-full w-8 h-8 flex items-center justify-center text-sm mr-3">3</span>
							Game Settings
						</h2>
						<div class="grid grid-cols-1 md:grid-cols-2 gap-6">
							<!-- Number of Questions -->
							<div>
								<label class="block text-sm font-medium text-gray-300 mb-2">Number of Questions</label>
								<select name="rounds" class="w-full bg-gray-700 border border-gray-600 rounded-lg px-4 py-2 text-white focus:border-purple-500 focus:ring-1 focus:ring-purple-500">
									<option value="5">5 Questions (Quick Game)</option>
									<option value="10" selected>10 Questions (Standard)</option>
									<option value="15">15 Questions (Extended)</option>
									<option value="20">20 Questions (Marathon)</option>
								</select>
							</div>
							<!-- Question Type -->
							<div>
								<label class="block text-sm font-medium text-gray-300 mb-2">Question Type</label>
								<select name="question_type" class="w-full bg-gray-700 border border-gray-600 rounded-lg px-4 py-2 text-white focus:border-purple-500 focus:ring-1 focus:ring-purple-500">
									<option value="song_title" selected>Guess Song Title</option>
									<option value="artist_name">Guess Artist Name</option>
									<option value="mixed">Mixed Questions</option>
								</select>
							</div>
						</div>
					</div>
					<!-- Start Game Button -->
					<div class="text-center">
						<button
							type="submit"
							class="start-game-btn bg-gradient-to-r from-green-500 to-blue-500 hover:from-green-600 hover:to-blue-600 text-white font-bold py-4 px-8 rounded-xl text-xl shadow-lg hover:shadow-xl transform hover:scale-105 transition-all duration-200 disabled:opacity-50 disabled:cursor-not-allowed disabled:transform-none"
							disabled
						>
							<span class="flex items-center">
								<svg class="w-6 h-6 mr-3" fill="currentColor" viewBox="0 0 24 24">
									<path d="M8 5v14l11-7z"></path>
								</svg>
								Start Game!
							</span>
						</button>
						<p class="text-gray-400 text-sm mt-2">Select a playlist and difficulty to begin</p>
					</div>
				</form>
			</div>
		</div>
	</div>
	<script>
		// Enable start button when playlist and difficulty are selected
		function updateStartButton() {
			const playlist = document.querySelector('input[name="selected_playlist"]:checked');
			const difficulty = document.querySelector('input[name="difficulty"]:checked');
			const startBtn = document.querySelector('.start-game-btn');
			
			if (playlist && difficulty) {
				startBtn.disabled = false;
				startBtn.querySelector('span').innerHTML = `
					<svg class="w-6 h-6 mr-3" fill="currentColor" viewBox="0 0 24 24">
						<path d="M8 5v14l11-7z"></path>
					</svg>
					Start Game!
				`;
			}
		}

		// Add click handlers for difficulty selection
		document.addEventListener('change', function(e) {
			if (e.target.name === 'difficulty') {
				// Remove active class from all difficulty cards
				document.querySelectorAll('.difficulty-card').forEach(card => {
					card.classList.remove('ring-2', 'ring-white');
				});
				// Add active class to selected card
				e.target.closest('.difficulty-card').classList.add('ring-2', 'ring-white');
				updateStartButton();
			}
			if (e.target.name === 'selected_playlist') {
				updateStartButton();
			}
		});
	</script>
}

templ PlaylistGrid(playlists []models.Playlist) {
	<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
		for _, playlist := range playlists {
			<label class="playlist-option cursor-pointer">
				<input type="radio" name="selected_playlist" value={ playlist.ID.String() } class="sr-only" required/>
				<div class="playlist-card bg-gray-700 hover:bg-gray-600 border-2 border-transparent hover:border-green-400 rounded-lg p-4 transition-all duration-200">
					<div class="flex items-center space-x-3">
						<div class="w-16 h-16 bg-gradient-to-br from-green-400 to-blue-500 rounded-lg flex items-center justify-center text-2xl">
							🎵
						</div>
						<div class="flex-1 min-w-0">
							<h3 class="font-bold text-white truncate">{ playlist.Name }</h3>
							<p class="text-gray-400 text-sm truncate">{ playlist.Description }</p>
							<p class="text-green-400 text-xs mt-1">{ strconv.Itoa(len(playlist.Songs)) } songs</p>
						</div>
					</div>
				</div>
			</label>
		}
	</div>
	if len(playlists) == 0 {
		<div class="text-center py-8">
			<div class="text-gray-400 mb-4">
				<svg class="w-16 h-16 mx-auto mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
					<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19V6l12-3v13M9 19c0 1.105-2.895 2-4 2s-4-.895-4-2 2.895-2 4-2 4 .895 4 2zm12-3c0 1.105-2.895 2-4 2s-4-.895-4-2 2.895-2 4-2 4 .895 4 2z"></path>
				</svg>
			</div>
			<h3 class="text-xl font-semibold text-gray-300 mb-2">No playlists found</h3>
			<p class="text-gray-400 mb-4">Import your Spotify playlists to start playing</p>
			<button
				hx-get="/api/import-spotify-playlists"
				hx-target="#playlist-grid"
				class="bg-green-500 hover:bg-green-600 text-white px-4 py-2 rounded-lg transition-colors"
			>
				Import Playlists
			</button>
		</div>
	}
	<script>
		// Add click handlers for playlist selection
		document.querySelectorAll('.playlist-option').forEach(option => {
			option.addEventListener('click', function() {
				// Remove active class from all playlist cards
				document.querySelectorAll('.playlist-card').forEach(card => {
					card.classList.remove('ring-2', 'ring-green-400');
				});
				// Add active class to selected card
				this.querySelector('.playlist-card').classList.add('ring-2', 'ring-green-400');
			});
		});
	</script>
}
