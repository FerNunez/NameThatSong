package templates

import "strconv"

templ ModernIndexPage() {
	<div class="min-h-full flex flex-col">
		<!-- Playlist Songs Section -->
		<div class="px-8 py-12 bg-forest-400 border-b-4 border-forest-200">
			@PlaylistSongs()
		</div>
	</div>
}

templ FeatureCard(icon, title, description string) {
	<div class="text-center p-6 bg-forest-300 rounded-xl border border-forest-200 hover:border-forest-100 transition-colors">
		<div class="text-4xl mb-4">{ icon }</div>
		<h3 class="text-xl font-semibold mb-3 text-white">{ title }</h3>
		<p class="text-forest-50 leading-relaxed">{ description }</p>
	</div>
}

templ QuickSearch() {
	<div class="h-80 overflow-y-auto border border-forest-200 rounded-lg bg-forest-300 p-4">
		<h3 class="text-2xl font-bold mb-6 text-white">Quick Search</h3>
		<div class="max-w-2xl mx-auto">
			@SearchInput("Search for songs, artists, or albums...", "main-search")
		</div>
		<div id="search-results" class="mt-8">
			<!-- Search results will appear here -->
		</div>
	</div>
}

templ PlaylistSongs() {
	<div class="max-w-4xl mx-auto">
		<div id="playlist-songs-container" class="h-80 overflow-y-auto border border-forest-200 rounded-lg bg-forest-300 p-4">
			<h3 class="text-2xl font-bold mb-6 text-white">Playlist Songs</h3>
			@PlaylistSongsEmpty()
		</div>
	</div>
}

templ PlaylistSongsEmpty() {
	<div class="flex items-center justify-center h-full">
		<div class="text-center">
			<div class="w-16 h-16 mx-auto mb-4 text-forest-50 opacity-50">
				<svg fill="currentColor" viewBox="0 0 20 20">
					<path fill-rule="evenodd" d="M3 4a1 1 0 011-1h12a1 1 0 110 2H4a1 1 0 01-1-1zm0 4a1 1 0 011-1h12a1 1 0 110 2H4a1 1 0 01-1-1zm0 4a1 1 0 011-1h12a1 1 0 110 2H4a1 1 0 01-1-1z" clip-rule="evenodd"></path>
				</svg>
			</div>
			<p class="text-forest-50 text-lg font-medium">Please select a playlist</p>
			<p class="text-forest-100 text-sm mt-2">Choose a playlist from the sidebar to view its songs</p>
		</div>
	</div>
}

templ PlaylistSongsWithData(songs []PlaylistSong) {
	<div class="space-y-3">
		for i, song := range songs {
			@PlaylistSongItem(song, i+1)
		}
	</div>
}

type PlaylistSong struct {
	ID       string
	Title    string
	Artist   string
	Duration string
	AlbumArt string
}

templ PlaylistSongItem(song PlaylistSong, index int) {
	<div class="flex items-center gap-4 p-3 rounded-lg hover:bg-forest-200 transition-colors group">
		<!-- Track Number -->
		<div class="w-8 h-8 flex items-center justify-center text-forest-50 font-medium text-sm">
			{ strconv.Itoa(index) }
		</div>
		<!-- Album Art -->
		<div class="w-12 h-12 bg-forest-200 rounded-lg flex-shrink-0 overflow-hidden">
			if song.AlbumArt != "" {
				<img src={ song.AlbumArt } alt={ song.Title } class="w-full h-full object-cover"/>
			} else {
				<div class="w-full h-full flex items-center justify-center">
					@MusicIcon()
				</div>
			}
		</div>
		<!-- Song Info -->
		<div class="flex-1 min-w-0">
			<p class="font-medium text-white truncate">{ song.Title }</p>
			<p class="text-forest-50 text-sm truncate">{ song.Artist }</p>
		</div>
		<!-- Duration -->
		<div class="text-forest-50 text-sm font-medium">
			{ song.Duration }
		</div>
		<!-- Action Buttons -->
		<div class="flex items-center gap-2 opacity-0 group-hover:opacity-100 transition-opacity">
			<button
				class="p-2 text-forest-50 hover:text-white hover:bg-forest-100 rounded transition-colors"
				title="Play song"
				hx-post="/api/play-song"
				hx-vals={ `{"songId": "` + song.ID + `"}` }
			>
				@PlayIcon()
			</button>
			<button
				class="p-2 text-forest-50 hover:text-accent hover:bg-forest-100 rounded transition-colors"
				title="Add to game queue"
				hx-post="/api/add-to-queue"
				hx-vals={ `{"songId": "` + song.ID + `"}` }
			>
				@PlusIcon()
			</button>
		</div>
	</div>
}

templ CreatePlaylistForm() {
	<div class="max-w-2xl mx-auto">
		<h3 class="text-2xl font-bold mb-6 text-white">Create New Playlist</h3>
		<form
			hx-post="/api/playlist/create"
			hx-target="#playlist-songs-container"
			hx-swap="innerHTML"
			class="space-y-4"
		>
			<div>
				<label for="playlist-name" class="block text-sm font-medium text-white mb-2">
					Playlist Name
				</label>
				<input
					type="text"
					id="playlist-name"
					name="name"
					required
					class="w-full px-3 py-2 bg-forest-200 border border-forest-100 rounded-lg text-white placeholder-forest-50 focus:outline-none focus:ring-2 focus:ring-accent focus:border-transparent"
					placeholder="Enter playlist name..."
					maxlength="100"
				/>
			</div>
			<div>
				<label for="playlist-description" class="block text-sm font-medium text-white mb-2">
					Description (Optional)
				</label>
				<textarea
					id="playlist-description"
					name="description"
					rows="3"
					class="w-full px-3 py-2 bg-forest-200 border border-forest-100 rounded-lg text-white placeholder-forest-50 focus:outline-none focus:ring-2 focus:ring-accent focus:border-transparent resize-none"
					placeholder="Enter playlist description..."
					maxlength="300"
				></textarea>
			</div>
			<div class="flex items-center">
				<input
					type="checkbox"
					id="is-public"
					name="is_public"
					class="h-4 w-4 text-accent focus:ring-accent border-forest-100 rounded bg-forest-200"
				/>
				<label for="is-public" class="ml-2 block text-sm text-white">
					Make this playlist public
				</label>
			</div>
			<div class="flex gap-3 pt-4">
				<button
					type="submit"
					class="px-6 py-2 bg-accent text-forest-400 font-medium rounded-lg hover:bg-opacity-90 transition-colors"
				>
					Create Playlist
				</button>
				<button
					type="button"
					class="px-6 py-2 bg-forest-200 text-white font-medium rounded-lg hover:bg-forest-100 transition-colors"
					hx-get="/api/playlist/cancel-create"
					hx-target="#playlist-songs-container"
					hx-swap="innerHTML"
				>
					Cancel
				</button>
			</div>
		</form>
	</div>
}

templ NewPlaylistView(playlist UserPlaylist) {
	<div class="max-w-4xl mx-auto">
		<div class="mb-6">
			<h3 class="text-2xl font-bold text-white mb-2">{ playlist.Name }</h3>
			<p class="text-forest-50 text-sm">New playlist • 0 songs</p>
		</div>
		<!-- Empty playlist state -->
		<div class="text-center py-12">
			<div class="w-16 h-16 mx-auto mb-4 text-forest-50 opacity-50">
				@MusicIcon()
			</div>
			<h4 class="text-lg font-medium text-white mb-2">Let's find something for your playlist</h4>
			<p class="text-forest-50 text-sm mb-6">Search for songs, artists, or albums to add to "{ playlist.Name }"</p>
			<div class="max-w-md mx-auto">
				<div class="relative">
					<input
						type="text"
						placeholder="Search for music..."
						class="w-full px-4 py-3 bg-forest-200 border border-forest-100 rounded-lg text-white placeholder-forest-50 focus:outline-none focus:ring-2 focus:ring-accent focus:border-transparent pl-10"
						hx-get="/api/search"
						hx-trigger="keyup changed delay:300ms"
						hx-target="#search-results"
						hx-vals={ `{"playlist_id": "` + playlist.ID + `"}` }
					/>
					<div class="absolute left-3 top-1/2 transform -translate-y-1/2 text-forest-50">
						<svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20">
							<path fill-rule="evenodd" d="M8 4a4 4 0 100 8 4 4 0 000-8zM2 8a6 6 0 1110.89 3.476l4.817 4.817a1 1 0 01-1.414 1.414l-4.816-4.816A6 6 0 012 8z" clip-rule="evenodd"></path>
						</svg>
					</div>
				</div>
			</div>
			<div id="search-results" class="mt-6">
				<!-- Search results will appear here -->
			</div>
		</div>
		<!-- Action buttons -->
		<div class="flex gap-3 pt-4 border-t border-forest-100">
			<button
				class="px-4 py-2 bg-forest-200 text-white font-medium rounded-lg hover:bg-forest-100 transition-colors"
				hx-get="/api/local-playlists"
				hx-target="#local-playlists"
				hx-swap="innerHTML"
				hx-trigger="click"
			>
				← Back to Playlists
			</button>
		</div>
	</div>
}
