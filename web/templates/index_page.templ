package templates

// Legacy IndexPage - keeping for backward compatibility
templ IndexPage() {
	<div>
		<script>
		function setSearchValue(name, id) {
		    const searchInput = document.querySelector('[name="search"]');  
		    const artistIdInput = document.querySelector('[name="artist-id"]');  
		    searchInput.value = name;
		    artistIdInput.value = id;  
		    document.getElementById('search-results').innerHTML = '';
		}
		function setGuessOption(name, id) {
		    const searchInput = document.querySelector('[name="guess"]');  
		    searchInput.value = name;
		    artistIdInput.value = id;  
		    document.getElementById('guess-results').innerHTML = '';
		}
		</script>
		<!-- Game Navigation -->
		<div class="container mx-auto px-4 py-8">
			<div class="text-center mb-8">
				<h1 class="text-4xl font-bold mb-4 text-transparent bg-clip-text bg-gradient-to-r from-green-400 to-blue-500">
					🎵 NameThatSong
				</h1>
				<p class="text-gray-300 text-lg mb-8">Test your music knowledge with our guessing game!</p>
				
				<div class="flex justify-center space-x-4 mb-8">
					<a hx-get="/game/setup" 
					   hx-target="body" 
					   hx-swap="outerHTML"
					   class="bg-gradient-to-r from-green-500 to-blue-500 hover:from-green-600 hover:to-blue-600 text-white font-bold py-4 px-8 rounded-xl text-xl shadow-lg hover:shadow-xl transform hover:scale-105 transition-all duration-200">
						🎮 Start Game
					</a>
					
					<a href="/search" 
					   class="bg-gray-700 hover:bg-gray-600 text-white font-bold py-4 px-8 rounded-xl text-xl shadow-lg hover:shadow-xl transform hover:scale-105 transition-all duration-200">
						🔍 Search Music
					</a>
					
					<a href="/modern" 
					   class="bg-accent hover:bg-green-400 text-forest-400 font-bold py-4 px-8 rounded-xl text-xl shadow-lg hover:shadow-xl transform hover:scale-105 transition-all duration-200">
						✨ New UI
					</a>
				</div>
			</div>
		</div>

		@SimpleSearchLayout()
	</div>
}
