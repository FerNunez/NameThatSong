package templates

templ InternalSpotifyCache() {
	<script src="https://unpkg.com/htmx.org@1.9.10"></script>
	<h1 class="text-2xl font-bold mb-6 text-center">Music Cache Info Lookup!</h1>
	<div class="flex flex-col justify-evenly h-[80vh] max-w-xl mx-auto">
		<!-- track id form -->
		<form>
			<label for="track-id">track id</label>
			<input type="text" id="track-id" name="id" placeholder="11dfghvxanmlkmjxsncbnl" required/>
			<button
				type="button"
				hx-get="/internal-spotifycache/track"
				hx-include="#track-id"
				hx-target="#track-response"
				hx-trigger="click"
			>submit</button>
			<div id="track-response"></div>
		</form>
		<!-- album id form -->
		<form>
			<label for="album-id">album id</label>
			<input type="text" id="album-id" name="id" placeholder="11dfghvxanmlkmjxsncbnl" required/>
			<button
				type="button"
				hx-get="/internal-spotifycache/album"
				hx-include="#album-id"
				hx-target="#album-response"
				hx-trigger="click"
			>submit</button>
			<div id="album-response"></div>
		</form>
		<!-- artist id form -->
		<form>
			<label for="artist-id">artist id</label>
			<input type="text" id="artist-id" name="id" placeholder="11dfghvxanmlkmjxsncbnl" required/>
			<button
				type="button"
				hx-get="/internal-spotifycache/artist"
				hx-include="#artist-id"
				hx-target="#artist-response"
				hx-trigger="click"
			>submit</button>
			<div id="artist-response"></div>
		</form>
		<!-- playlist id form -->
		<form>
			<label for="playlist-id">playlist id</label>
			<input type="text" id="playlist-id" name="id" placeholder="11dfghvxanmlkmjxsncbnl" required/>
			<button
				type="button"
				hx-get="/internal-spotifycache/playlist"
				hx-include="#playlist-id"
				hx-target="#playlist-response"
				hx-trigger="click"
			>submit</button>
			<div id="playlist-response"></div>
		</form>
	</div>
	<h1 class="text-2xl font-bold mb-6 text-center">Search by name</h1>
	<div class="flex flex-col justify-evenly h-[80vh] max-w-xl mx-auto">
		<!-- track id form -->
		<form>
			<label for="track-name">track name</label>
			<input type="text" id="track-name" name="name" placeholder="re forro" required/>
			<button
				type="button"
				hx-get="/internal/spotifycache/track/name"
				hx-include="#track-name"
				hx-target="#track-name-response"
				hx-trigger="click"
			>submit</button>
			<div id="track-name-response"></div>
		</form>
	</div>
}
